{
  "name": "lekha",
  "version": "0.0.1",
  "type": "module",
  "description": "A privacy-focused personal finance and expense tracking platform for recording expenses, managing budgets, organizing transactions with categories and tags, and gaining insights into spending habits.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sain-Biswas/lekha.git"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "author": {
    "name": "Sain Biswas",
    "url": "https://github.com/Sain-Biswas"
  },
  "license": "GPL-3.0-only",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@effect/tsgo": "^0.63.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}